{
  "name": "borodutch-stats",
  "version": "1.0.0",
  "description": "Borodutch stats server",
  "main": "dist/app.js",
  "repository": "https://github.com/backmeupplz/borodutch-stats",
  "author": "backmeupplz <backmeupplz@gmail.com>",
  "license": "MIT",
  "private": false,
  "scripts": {
    "distribute": "yarn build-ts && node dist/app.js",
    "develop": "concurrently -i -k -p \"[{name}]\" -n \"Node, TypeScript\" -c \"yellow.bold,cyan.bold\" \"yarn watch-js\" \"yarn watch-ts\"",
    "build-ts": "tsc --skipLibCheck",
    "watch-ts": "tsc -w --skipLibCheck",
    "watch-js": "nodemon dist/app.js",
    "test": "tsc --skipLibCheck && jest"
  },
  "devDependencies": {
    "concurrently": "^4.1.2",
    "jest": "26.6.3",
    "nodemon": "^1.18.11"
  },
  "dependencies": {
    "@koa/cors": "^3.0.0",
    "@types/axios": "^0.14.0",
    "@types/dotenv": "^6.1.1",
    "@types/node": "^12.7.2",
    "axios": "^0.31.1",
    "dotenv": "^8.0.0",
    "koa": "^3.1.2",
    "koa-bodyparser-ts": "^0.3.1",
    "koa-router-ts": "^3.0.0",
    "mongoose": "^6.13.9",
    "telegraf": "^3.37.0",
    "typescript": "4.9.5"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
